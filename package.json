{
  "name": "lamadeja-saas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test:containers": "node scripts/staging/check-containers.mjs",
    "test:staging:real": "npm run build -w @lamadeja/api && node scripts/staging/run-real-smoke.mjs",
    "dev:api": "npm run dev -w @lamadeja/api",
    "dev:web": "npm run dev -w @lamadeja/web",
    "worker:outbox": "npm run worker:outbox -w @lamadeja/api",
    "worker": "npm run worker -w @lamadeja/api",
    "lint": "npm run typecheck --workspaces -- --noUnusedLocals --noUnusedParameters",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test scripts/test/*.test.mjs && npm run test -w @lamadeja/api",
    "worker:nadia": "npm run worker:nadia -w @lamadeja/api",
    "test:nadia:real": "npm run build -w @lamadeja/api && node scripts/check-nadia-nvidia.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
