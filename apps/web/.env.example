VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_API_URL=http://localhost:4000
# API and frontend must use the same authentication project.
# Google returns to <frontend origin>/auth/callback (PKCE).
# For development prefer Supabase local; do not change a production project's OAuth settings.
