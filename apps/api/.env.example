PORT=4000
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# MVP only: restrict to the same users authorized in Live Manager
ALLOWED_EMAILS=authorized@example.com
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN
# Tenant is fixed server-side for MVP; do not accept it from HTTP clients
MVP_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
MVP_STORE_ID=00000000-0000-0000-0000-000000000001

# Dedicated SaaS PostgreSQL instance; NEVER Live Manager production DB
# Leave unset until migrations and isolated test DB are ready. POST then returns 503.
# DATABASE_URL=postgresql://user:password@localhost:5432/lamadeja_saas

WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_SECONDS=30
WORKER_TIMEOUT_MS=15000
WORKER_POLL_MS=1000

# Explicit opt-in for simulation only; no real WhatsApp transport exists.
OUTBOX_MODE=disabled

# Bounded connection startup. Container worker health is configured per service.
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Nadia requires separate explicit simulation opt-in and an approved NVIDIA model.
NADIA_MODE=disabled
NVIDIA_API_KEY=
NADIA_MODEL=
NADIA_TIMEOUT_MS=12000
NADIA_MIN_INTERVAL_MS=2000
